 * {
    font: "Caskaydia Nerd Font 13";
    g-spacing: 10px;
    g-margin: 0;
    b-color: #000000FF;
    fg-color: #FFFFFFFF;
    fgp-color: #888888FF;
    b-radius: 8px;
    g-padding: 8px;
    hl-color: #FFFFFFFF;
    hlt-color: #000000FF;
    alt-color: #111111FF;
    wbg-color: #000000CC;
    w-border: 2px solid;
    w-border-color: #FFFFFFFF;
    w-padding: 12px;

		base00: #2e3440FF;
		base01: #3b425fFF;
		base02: #434c5eFF;
		base03: #4c566aFF;
		base04: #e3f4ffFF;
		base07: #c7faffFF;
		base08: #9ad4fbFF;
		base09: #386fcdFF;
		base0B: #a3f1fdFF;
		base0C: #5a8fb8FF;
		base0D: #def9ffFF;
		base0E: #eec6f5FF;
		base0F: #c8f8f7FF;

		border-radius: 1px;
		border-bars: 0px 2px 2px 0px;
		border-px: 4px;
		window-padding: 5px;

		backGroundTransparent: #2e3440CC;

		border: 0px;
		border-color: transparent;

		var-padding: 8px;
		var-spacing: 10px;
		var-margin: 5px;
}

// @theme "/dev/null"

configuration {
    modi: "drun,run";
    show-icons: false;
    display-drun: " ";
		display-run: "";

		kb-remove-to-eol: "";
		kb-accept-entry: "";

		kb-row-up: "Up,Control+k";
		kb-row-down: "Down,Control+j";
		kb-accept-entry: "Return";
}

listview {
		enabled: true;
    columns: 1;
    lines: 3;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px 0px 0px 0px;
		background-color: @base00;
		border-color: @base0E;
		border-radius: 2px;
}

window {
    transparency: "real";
    width: 650px;
    border-radius: 1px;
    background-color: @backGroundTransparent;
    border: 5px;
    border-color: @base0D;
    padding: @window-padding;
}

prompt {
    text-color: inherit;
		enabled: true;
		background-color: inherit;
}

inputbar {
	enabled: true;
	border: @border-bars;
	background-color: inherit;
	text-color: @base04;
	border-radius: 2px;
	border-color: @base08;
  children: ["prompt", "entry"];
}

entry {
    placeholder: "...";
    text-color: @base03;
    placeholder-color: @base07;
		background-color: inherit;
		text-color: inherit;
}

mainbox {
    spacing: @var-spacing;
    margin: 0px;
    padding: @var-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @var-spacing;
    margin: 0px;
    padding: 10px;
    border: 0px solid;
    border-radius: @border-radius;
    border-color: @base08;
    background-color: transparent;
    text-color: @base0E;
}

element normal.normal {
	background-color: @base00;
	text-color: @base04;
}

element alternate.normal {
	background-color: @base00;
	text-color: @base04;
}

element selected.active {
	background-color: @backGroundTransparent;
	text-color: @hlt-color;
}

element selected.normal {
	background-color: @base03;
	text-color: @base07;
}

message {
    background-color: red;
    border: 0px solid;
}
